# ==============================================================================
# Nationrise CRM - Production Environment Configuration
# ==============================================================================

# Application Environment
VITE_APP_ENV=production
VITE_APP_NAME="Nationrise CaseOS"
VITE_APP_VERSION="1.0.0"
VITE_APP_URL="https://crm.nationrise.ca"

# API & Backend Services (Relative proxy or production API domain)
VITE_API_BASE_URL="/api"
VITE_API_TIMEOUT=30000

# Feature Toggles & Production Settings
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEMO_BANNER=false

# Server / Production Nginx Container Port
PORT=80
HOST=0.0.0.0
