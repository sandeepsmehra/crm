# ==============================================================================
# Nationrise CRM - Environment Template (.env.example)
# Copy this file to .env.development or .env.production as needed
# ==============================================================================

# Application Environment (development | staging | production)
VITE_APP_ENV=development
VITE_APP_NAME="Nationrise CaseOS"
VITE_APP_VERSION="1.0.0"
VITE_APP_URL="http://localhost:5173"

# Backend API Configuration
VITE_API_BASE_URL="https://abc-fastapi.com/v1/api"
VITE_API_TIMEOUT=15000

# Feature Flags
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_DEMO_BANNER=true

# Server & Docker Container Ports
PORT=5173
HOST=0.0.0.0
